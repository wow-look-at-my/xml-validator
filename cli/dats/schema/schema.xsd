<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

<xs:simpleType name="nonEmpty">
<xs:restriction base="xs:string">
<xs:minLength value="1"/>
</xs:restriction>
</xs:simpleType>

<xs:simpleType name="parseType">
<xs:restriction base="xs:string">
<xs:pattern value="string|integer|boolean|string\[\]|enum\([^)]*,[^)]*\)"/>
</xs:restriction>
</xs:simpleType>

<xs:simpleType name="alignType">
<xs:restriction base="xs:string">
<xs:pattern value="left|center|right"/>
</xs:restriction>
</xs:simpleType>

<xs:simpleType name="boolType">
<xs:restriction base="xs:string">
<xs:pattern value="true|false"/>
</xs:restriction>
</xs:simpleType>

<xs:simpleType name="trueFalse">
<xs:restriction base="xs:token">
<xs:enumeration value="true"/>
<xs:enumeration value="false"/>
</xs:restriction>
</xs:simpleType>

<xs:simpleType name="paddingType">
<xs:restriction base="xs:string">
<xs:pattern value="[0-9]+|[0-9]+ [0-9]+|[0-9]+ [0-9]+ [0-9]+ [0-9]+"/>
</xs:restriction>
</xs:simpleType>

<xs:simpleType name="borderType">
<xs:restriction base="xs:string">
<xs:pattern value="none|thin|double"/>
</xs:restriction>
</xs:simpleType>

<xs:complexType name="entryType">
<xs:all>
<xs:element name="body" minOccurs="1" maxOccurs="1"/>
<xs:element name="option" type="optionType" minOccurs="0" maxOccurs="unbounded"/>
</xs:all>
<xs:attribute name="name" type="nonEmpty" use="required"/>
<xs:attribute name="label" type="xs:string"/>
</xs:complexType>

<xs:complexType name="sectionType">
<xs:all>
<xs:element name="body" minOccurs="1" maxOccurs="1"/>
</xs:all>
<xs:attribute name="name" type="nonEmpty" use="required"/>
</xs:complexType>

<xs:complexType name="optionType">
<xs:attribute name="name" type="nonEmpty" use="required"/>
<xs:attribute name="type" type="parseType" use="required"/>
<xs:attribute name="required" type="trueFalse"/>
</xs:complexType>

<xs:complexType name="styleType">
<xs:attribute name="name" type="nonEmpty" use="required"/>
<xs:attribute name="align" type="alignType"/>
<xs:attribute name="bold" type="boolType"/>
<xs:attribute name="padding" type="paddingType"/>
<xs:attribute name="border" type="borderType"/>
</xs:complexType>

<xs:complexType name="includeType">
<xs:attribute name="src" type="nonEmpty" use="required"/>
</xs:complexType>

<xs:complexType name="colorValue">
<xs:attribute name="name" type="nonEmpty" use="required"/>
<xs:attribute name="value" type="xs:string" use="required"/>
</xs:complexType>

<xs:complexType name="colorPair">
<xs:attribute name="name" type="nonEmpty" use="required"/>
<xs:attribute name="light" type="nonEmpty" use="required"/>
<xs:attribute name="dark" type="nonEmpty" use="required"/>
<xs:attribute name="value" use="prohibited"/>
</xs:complexType>

<xs:complexType name="themeType">
<xs:all>
<xs:element name="color" minOccurs="0" maxOccurs="unbounded">
<xs:alternative test="@value" type="colorValue"/>
<xs:alternative type="colorPair"/>
</xs:element>
</xs:all>
<xs:attribute name="name" type="nonEmpty" use="required"/>
</xs:complexType>

<xs:element name="catalog">
<xs:complexType>
<xs:all>
<xs:element name="entry" type="entryType" minOccurs="0" maxOccurs="unbounded"/>
<xs:element name="section" type="sectionType" minOccurs="0" maxOccurs="unbounded"/>
<xs:element name="style" type="styleType" minOccurs="0" maxOccurs="unbounded"/>
<xs:element name="theme" type="themeType" minOccurs="0"/>
<xs:element name="include" type="includeType" minOccurs="0" maxOccurs="unbounded"/>
</xs:all>
</xs:complexType>
</xs:element>

</xs:schema>
